---
/**
 * White form card with the "[Form not connected yet]" note, a spam-check
 * placeholder, a privacy line and a purple submit button. There is no backend
 * yet (Cloudflare Functions, D1 and Turnstile come later), so the script only
 * validates fields and never sends anything.
 */
import site from '../../data/site.json';
import Button from '../Button.astro';
import Placeholder from '../Placeholder.astro';

interface Props {
  id: string;
  title: string;
  intro?: string;
  submitLabel: string;
}

const { id, title, intro, submitLabel } = Astro.props;
---

<form
  id={id}
  novalidate
  aria-labelledby={`${id}-title`}
  aria-describedby={`${id}-notice`}
  class="flex flex-col gap-5 rounded-card bg-white p-6 shadow-[0_12px_40px_rgb(36_32_56/0.08)] sm:p-9"
  data-static-form
>
  <div class="flex flex-col gap-2">
    <h2 id={`${id}-title`} class="text-[26px] leading-tight font-extrabold text-navy">{title}</h2>
    {intro && <p class="text-ink-2">{intro}</p>}
  </div>
  <p id={`${id}-notice`} class="rounded-input border-[1.5px] border-dashed border-border-input bg-surface px-4 py-3 text-sm text-navy">
    <strong>[Form not connected yet]</strong> Nothing is sent from this form yet. Please email
    <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> instead.
  </p>

  <slot />

  <Placeholder label="[Spam check: Cloudflare Turnstile]" class="h-[65px] w-[300px] max-w-full rounded-input text-sm" />
  <p class="text-sm text-muted">
    We only use these details to reply to you. Read our <a href="/privacy">privacy policy</a>.
  </p>
  <Button type="submit" class="self-start">{submitLabel}</Button>
  <p role="status" class="text-sm font-semibold text-navy empty:hidden" data-form-status></p>
</form>

<script>
  type Control = HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement;

  const showError = (control: Control) => {
    const error = document.getElementById(`${control.id}-error`);
    if (!error) return;
    const invalid = !control.validity.valid;
    control.toggleAttribute('aria-invalid', invalid);
    error.hidden = !invalid;
    const message = control.validity.typeMismatch
      ? 'Please check the format.'
      : (error.dataset.error ?? control.validationMessage);
    error.querySelector('span')!.textContent = invalid ? message : '';
  };

  document.querySelectorAll<HTMLFormElement>('form[data-static-form]').forEach((form) => {
    const controls = [...form.querySelectorAll<Control>('input, textarea, select')];
    const status = form.querySelector<HTMLElement>('[data-form-status]')!;

    controls.forEach((control) =>
      control.addEventListener('input', () => control.hasAttribute('aria-invalid') && showError(control)),
    );

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      controls.forEach(showError);
      const firstInvalid = controls.find((control) => !control.validity.valid);
      if (firstInvalid) {
        status.textContent = '';
        firstInvalid.focus();
      } else {
        status.textContent = '[Form not connected yet] Your message was not sent.';
      }
    });
  });
</script>
