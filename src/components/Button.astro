---
/** Pill button (design system → Button). Renders a link when `href` is set. */
interface Props {
  href?: string;
  variant?: 'primary' | 'dark' | 'gold' | 'light' | 'white' | 'outline-light';
  size?: 'md' | 'sm';
  type?: 'button' | 'submit';
  class?: string;
  [attr: string]: unknown;
}

const { href, variant = 'primary', size = 'md', type = 'button', class: className, ...rest } = Astro.props;

const variants = {
  primary: 'bg-purple text-white hover:bg-purple-dark hover:text-white',
  dark: 'bg-navy text-white hover:bg-ink-2 hover:text-white',
  gold: 'bg-gold text-navy hover:bg-[#fdcd7e] hover:text-navy',
  light: 'bg-white text-purple-dark hover:bg-on-purple hover:text-purple-dark',
  white: 'bg-white text-navy hover:bg-on-purple hover:text-navy',
  'outline-light': 'border-2 border-white text-white hover:bg-white/10 hover:text-white',
};
const sizes = { md: 'min-h-13 px-7', sm: 'min-h-11 px-[22px]' };
const classes = [
  'inline-flex items-center justify-center gap-2 rounded-full text-center font-bold leading-tight no-underline transition-colors',
  variants[variant],
  sizes[size],
  className,
];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
