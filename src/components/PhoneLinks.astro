---
/**
 * Phone numbers, each shown as the WhatsApp icon (opens WhatsApp) and the
 * number (calls it), with no extra labels. `whatsappOnly` numbers don't take
 * calls, so the icon and number are one WhatsApp link.
 */
import BrandIcon from './BrandIcon.astro';
import { phones as schoolPhones, telHref, whatsappHref, type Phone } from '../lib/contact';

interface Props {
  phones?: Phone[];
  whatsappOnly?: boolean;
  /** Link classes, e.g. for the footer's colours and row height. */
  linkClass?: string;
}

const { phones = schoolPhones, whatsappOnly = false, linkClass = 'min-h-11 font-semibold' } = Astro.props;
---

<ul class="flex flex-col">
  {
    phones.map((phone) =>
      whatsappOnly ? (
        <li>
          <a href={whatsappHref(phone)} class:list={['inline-flex items-center gap-2', linkClass]}>
            <BrandIcon name="whatsapp" size={18} />
            <span class="sr-only">WhatsApp </span>
            {phone.display}
          </a>
        </li>
      ) : (
        <li class="flex items-center gap-1">
          {phone.whatsapp && (
            <a href={whatsappHref(phone)} class:list={['-ms-1.5 inline-flex min-w-9 items-center justify-center', linkClass]}>
              <BrandIcon name="whatsapp" size={18} />
              <span class="sr-only">WhatsApp {phone.display}</span>
            </a>
          )}
          <a href={telHref(phone)} class:list={['inline-flex items-center', linkClass]}>
            {phone.display}
          </a>
        </li>
      ),
    )
  }
</ul>
