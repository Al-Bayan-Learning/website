---
/** Both school phone numbers, each a WhatsApp link with the icon before it (site.json → contact.phones). */
import BrandIcon from './BrandIcon.astro';
import { phones, telHref, whatsappHref } from '../lib/contact';

interface Props {
  /** Show the +92 number under each, for callers outside Pakistan. */
  international?: boolean;
}

const { international = false } = Astro.props;
---

<ul class:list={["flex flex-col", international && "gap-2"]}>
  {
    phones.map((phone) => (
      <li class="flex flex-wrap items-center gap-x-4">
        <a href={phone.whatsapp ? whatsappHref(phone) : telHref(phone)} class="inline-flex min-h-9 items-center gap-2 font-semibold">
          {phone.whatsapp && <BrandIcon name="whatsapp" size={18} />}
          {phone.whatsapp && <span class="sr-only">WhatsApp </span>}
          {phone.display}
        </a>
        {international && <span class="basis-full text-sm text-muted">From outside Pakistan: {phone.international}</span>}
      </li>
    ))
  }
</ul>
