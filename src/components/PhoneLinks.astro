---
/** Both school phone numbers, each with a WhatsApp link (site.json → contact.phones). */
import Icon from './Icon.astro';
import { phones, telHref, whatsappHref } from '../lib/contact';

interface Props {
  /** Show the +92 number under each, for callers outside Pakistan. */
  international?: boolean;
}

const { international = false } = Astro.props;
---

<ul class="flex flex-col gap-1">
  {
    phones.map((phone) => (
      <li class="flex flex-wrap items-center gap-x-4">
        <a href={telHref(phone)} class="inline-flex min-h-11 items-center font-semibold">{phone.display}</a>
        {phone.whatsapp && (
          <a href={whatsappHref(phone)} class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold">
            <Icon name="chat" size={18} />
            WhatsApp<span class="sr-only"> {phone.display}</span>
          </a>
        )}
        {international && <span class="basis-full text-sm text-muted">From outside Pakistan: {phone.international}</span>}
      </li>
    ))
  }
</ul>
