---
import site from '../data/site.json';
---

<main class="flex min-h-screen flex-col items-center justify-center gap-8 px-6 py-16 text-center">
  <img
    src="/logo-placeholder.svg"
    alt={`${site.name} logo`}
    width="96"
    height="96"
    class="h-24 w-24"
  />

  <div class="space-y-3">
    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl">
      {site.name}
    </h1>
    <p class="text-lg text-slate-600">{site.tagline}</p>
  </div>

  <div class="space-y-2">
    <p class="text-sm font-medium uppercase tracking-wide text-teal-700">
      Our new website is coming soon
    </p>
    <p class="text-slate-600">
      In the meantime, reach us at
      <a
        href={`mailto:${site.contact.email}`}
        class="font-medium text-teal-700 underline underline-offset-4 hover:text-teal-800"
      >
        {site.contact.email}
      </a>
    </p>
  </div>
</main>
