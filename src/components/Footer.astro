---
/** Navy three-column footer (design system → Footer). */
import site from '../data/site.json';
import BrandIcon, { type BrandName } from './BrandIcon.astro';
import { footerNav } from '../data/navigation';
import { phones, telHref, whatsappHref } from '../lib/contact';

const { contact, socials } = site;
const link = 'inline-flex min-h-11 items-center text-on-navy hover:text-white';
---

<footer class="band-dark bg-navy text-[15px] text-on-navy">
  <div class="container-site grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-8 pt-16 pb-8">
    <div class="flex flex-col gap-2.5">
      <p class="font-display text-[30px] leading-[1.1] text-white">
        Al-Bayan Learning<br /><span class="text-cyan">Initiative</span>
      </p>
      <p>{site.footerAbout}</p>
    </div>

    <nav aria-labelledby="footer-explore" class="flex flex-col">
      <h2 id="footer-explore" class="mb-1 font-bold text-gold">Explore</h2>
      {footerNav.map(({ label, href }) => <a href={href} class={link}>{label}</a>)}
    </nav>

    <div class="flex flex-col">
      <h2 class="mb-1 font-bold text-gold">Contact</h2>
      <a href={`mailto:${contact.email}`} class={link}>{contact.email}</a>
      {/* One WhatsApp link per number. Rows are 36px, not the usual 44px, so the two numbers sit closer together. */}
      <ul class="flex flex-col">
        {
          phones.map((phone) => (
            <li>
              <a href={phone.whatsapp ? whatsappHref(phone) : telHref(phone)} class="inline-flex min-h-9 items-center gap-2 text-on-navy hover:text-white">
                {phone.whatsapp && <BrandIcon name="whatsapp" size={16} />}
                {phone.whatsapp && <span class="sr-only">WhatsApp </span>}
                {phone.display}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="py-2.5">{contact.address}</p>
      <ul class="-ms-[11px] flex flex-wrap gap-x-1" aria-label="Social media">
        {
          socials.map((social) => (
            <li>
              <a href={social.url} class={`${link} min-w-11 justify-center`}>
                <BrandIcon name={social.icon as BrandName} size={22} />
                <span class="sr-only">{social.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container-site">
    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-navy-line pt-2 pb-5 text-[13px] text-on-navy-muted">
      <span>© {new Date().getFullYear()} {site.legalName}{site.registrationNo && ` · Registration no. ${site.registrationNo}`}</span>
      <a href="/privacy" class="inline-flex min-h-11 items-center text-on-navy-muted hover:text-white">Privacy</a>
    </div>
  </div>
</footer>
