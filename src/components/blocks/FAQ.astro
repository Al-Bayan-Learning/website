---
/** FAQ accordion built on <details> (works without JavaScript). */
import Icon from '../Icon.astro';

interface Props {
  items: { question: string; answer: string }[];
}

const { items } = Astro.props;
---

<div class="flex flex-col gap-3">
  {
    items.map((item) => (
      <details class="group rounded-card bg-surface">
        <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-card px-6 py-5 text-lg font-bold text-navy [&::-webkit-details-marker]:hidden">
          {item.question}
          <Icon name="plus" size={26} class="text-purple group-open:rotate-45 motion-safe:transition-transform" />
        </summary>
        <p class="px-6 pb-6 text-ink-2">{item.answer}</p>
      </details>
    ))
  }
</div>
