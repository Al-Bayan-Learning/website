---
/** Category pill (design system → Tag). Text is navy unless the pill is purple. */
import type { Palette } from '../lib/content';

interface Props {
  colour: Palette;
  class?: string;
}

const { colour, class: className } = Astro.props;
const colours: Record<Palette, string> = {
  gold: 'bg-gold text-navy',
  cyan: 'bg-cyan text-navy',
  green: 'bg-green text-navy',
  purple: 'bg-purple text-white',
  navy: 'bg-navy text-white',
};
---

<span class:list={['inline-block self-start rounded-full px-3 py-0.5 text-[13px] font-bold', colours[colour], className]}>
  <slot />
</span>
