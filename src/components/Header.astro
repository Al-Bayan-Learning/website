---
/**
 * Site header (design system → Header). At 900px and up the nav sits inline;
 * below that a 44×44 menu button opens a full-width navy panel that closes
 * with Esc.
 */
import site from '../data/site.json';
import { mainNav, getInvolved, isCurrent } from '../data/navigation';
import Button from './Button.astro';
import Icon from './Icon.astro';

const path = Astro.url.pathname;
---

<header class="relative z-40 bg-white" data-site-header>
  <div class="container-site flex items-center justify-between gap-4 py-3.5">
    <a href="/" class="flex items-center gap-3 no-underline">
      <img src="/images/albayan-logo.png" alt="" width="51" height="58" class="block h-[58px] w-auto" />
      <span class="text-[15px] leading-tight font-bold text-navy">
        <span class="sr-only">{site.name}, home</span>
        <span aria-hidden="true">Al-Bayan Learning<br />Initiative</span>
      </span>
    </a>

    <nav aria-label="Main" class="hidden flex-wrap items-center justify-end gap-x-[22px] gap-y-1 text-[15px] font-semibold nav:flex">
      {
        mainNav.map(({ label, href }) => {
          const current = isCurrent(path, href);
          return (
            <a
              href={href}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'inline-flex min-h-11 items-center no-underline',
                current
                  ? 'text-purple underline decoration-cyan decoration-[3px] underline-offset-[10px]'
                  : 'text-navy hover:text-purple',
              ]}
            >
              {label}
            </a>
          );
        })
      }
      <Button href={getInvolved.href} variant="dark" size="sm" aria-current={isCurrent(path, getInvolved.href) ? 'page' : undefined}>
        {getInvolved.label}
      </Button>
    </nav>

    <button
      type="button"
      class="group inline-flex size-11 items-center justify-center rounded-full text-navy hover:bg-surface nav:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-button
    >
      <span class="sr-only">Menu</span>
      <Icon name="menu" size={28} class="group-aria-expanded:hidden" />
      <Icon name="close" size={28} class="hidden group-aria-expanded:block" />
    </button>
  </div>

  <div id="mobile-menu" class="band-dark absolute inset-x-0 top-full bg-navy shadow-xl nav:hidden" hidden data-menu-panel>
    <nav aria-label="Main" class="container-site flex flex-col gap-1 pt-4 pb-8">
      {
        mainNav.map(({ label, href }) => {
          const current = isCurrent(path, href);
          return (
            <a
              href={href}
              aria-current={current ? 'page' : undefined}
              class:list={[
                'flex min-h-13 items-center text-2xl font-bold text-white no-underline hover:text-cyan-light',
                current && 'underline decoration-cyan decoration-[3px] underline-offset-8',
              ]}
            >
              {label}
            </a>
          );
        })
      }
      <Button href={getInvolved.href} variant="gold" class="mt-4 self-start">
        {getInvolved.label}
      </Button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (button && panel) {
    const setOpen = (open: boolean, returnFocus = false) => {
      button.setAttribute('aria-expanded', String(open));
      panel.hidden = !open;
      if (open) panel.querySelector<HTMLElement>('a')?.focus();
      else if (returnFocus) button.focus();
    };

    button.addEventListener('click', () => setOpen(button.getAttribute('aria-expanded') !== 'true'));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !panel.hidden) setOpen(false, true);
    });

    // Close when focus or a click leaves the header, and when the window
    // grows past the mobile breakpoint.
    const header = document.querySelector('[data-site-header]')!;
    document.addEventListener('click', (event) => {
      if (!panel.hidden && !header.contains(event.target as Node)) setOpen(false);
    });
    header.addEventListener('focusout', (event) => {
      if (!panel.hidden && !header.contains(event.relatedTarget as Node | null)) setOpen(false);
    });
    matchMedia('(min-width: 56.25rem)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>
