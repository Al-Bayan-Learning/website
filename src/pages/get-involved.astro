---
import SiteLayout from '../layouts/SiteLayout.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import InfoCard from '../components/blocks/InfoCard.astro';
import JobCard from '../components/cards/JobCard.astro';
import Field from '../components/forms/Field.astro';
import FormCard from '../components/forms/FormCard.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

// Text: docs/content.md (Get involved).
const { contact } = site;
const jobs = await getCollection('jobs', ({ data }) => data.open);

const topics = [
  'UN Sustainable Development Goals, such as climate change and gender equality',
  'Debates',
  'Drama',
  'Critical thinking',
  'Karate',
  'Any other informative or activity-based session',
];
---

<SiteLayout title="Get involved" description="Volunteer to teach a session at Al-Bayan's Saturday Scholars Programme, see job openings, and find out how to support the school.">
  <PageHero
    eyebrow="Get involved"
    title="Help us reach more children"
    intro="Volunteer for our Saturday Scholars Programme, join our team, or support the school."
    breadcrumbs={[{ label: 'Get involved' }]}
  />

  <section aria-labelledby="saturday-scholars" class="container-site grid gap-12 py-14 md:grid-cols-[1.3fr_1fr] md:py-22">
    <div class="flex flex-col gap-5">
      <SectionHeading id="saturday-scholars" eyebrow="Volunteer" title="Teach at Saturday Scholars" />
      <p class="text-ink-2">
        We welcome volunteers for our Saturday Scholars Programme. You can teach a skill or topic you care about.
      </p>
      <ul class="flex flex-wrap gap-2" aria-label="Session ideas">
        {topics.map((topic) => <li class="rounded-full border border-border-chip px-4 py-1.5 text-[15px] font-semibold text-navy">{topic}</li>)}
      </ul>
      <a href="/co-curricular#saturday-scholars" class="inline-flex min-h-11 items-center self-start font-bold">See past Saturday Scholars sessions</a>
    </div>
    <ul class="flex flex-col gap-4 self-start">
      <li class="flex items-center gap-4 rounded-card bg-cyan p-6 text-navy">
        <Icon name="clock" size={32} />
        <span><strong class="block font-display text-[34px] leading-none font-normal">One hour</strong>per session</span>
      </li>
      <li class="flex items-center gap-4 rounded-card bg-gold p-6 text-navy">
        <Icon name="calendar" size={32} />
        <span><strong class="block font-display text-[34px] leading-none font-normal">Three Saturdays</strong>minimum commitment</span>
      </li>
    </ul>
  </section>

  <section id="volunteer" aria-label="Volunteer sign-up" class="bg-surface">
    <div class="container-site grid items-start gap-10 py-14 lg:grid-cols-[1fr_1.4fr] md:py-22">
      <div class="flex flex-col gap-5">
        <SectionHeading eyebrow="Sign up" title="Tell us what you'd like to teach" />
        <p class="text-ink-2">Share a few details and we'll be in touch about a Saturday that suits you.</p>
        <InfoCard icon="mail" colour="cyan" title="Email">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </InfoCard>
      </div>
      <FormCard id="volunteer-form" title="Volunteer sign-up" submitLabel="Send">
        <Field form="volunteer-form" name="name" label="Name" required autocomplete="name" />
        <div class="grid gap-5 sm:grid-cols-2">
          <Field form="volunteer-form" name="email" label="Email" type="email" required autocomplete="email" error="Please enter an email address, like name@example.com." />
          <Field form="volunteer-form" name="phone" label="Phone" type="tel" required autocomplete="tel" error="Please enter a phone number we can call." />
        </div>
        <Field form="volunteer-form" name="teach" label="What would you like to teach?" type="textarea" required rows="3" error="Please tell us what you'd like to teach." />
        <Field form="volunteer-form" name="saturdays" label="Which Saturdays can you commit to?" required hint="Sessions are one hour; we ask for at least three Saturdays." error="Please tell us which Saturdays you can do." />
      </FormCard>
    </div>
  </section>

  <section id="jobs" aria-labelledby="jobs-title" class="band-dark bg-navy text-white">
    <div class="container-site flex flex-col gap-8 py-14 md:py-22">
      <SectionHeading id="jobs-title" eyebrow="Careers" title="Job openings" tone="dark" />
      {
        jobs.length > 0 ? (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6">
            {jobs.map((job) => <JobCard entry={job} />)}
          </div>
        ) : (
          <p class="max-w-[640px] rounded-card border border-navy-line p-8 text-lg text-on-navy">
            We don't have any openings right now. You're welcome to send your CV to{' '}
            <a href={`mailto:${contact.careersEmail}`} class="font-semibold text-cyan-light hover:text-white">{contact.careersEmail}</a>.
          </p>
        )
      }
    </div>
  </section>

  <section aria-labelledby="support" class="bg-gold">
    <div class="container-site flex flex-wrap items-center justify-between gap-6 py-14 md:py-20">
      <div class="flex flex-[1_1_440px] flex-col gap-3">
        <p class="eyebrow text-navy">Donate</p>
        <h2 id="support" class="text-h2 font-extrabold">Support the school</h2>
        <p>Online giving is coming soon. Until then, email us to find out how you can support Al-Bayan.</p>
      </div>
      <Button href={`mailto:${contact.email}?subject=${encodeURIComponent('Supporting Al-Bayan')}`} variant="dark">Email us</Button>
    </div>
  </section>

  <CTABand
    title="Want to talk it through?"
    text="Email, call or WhatsApp us and we'll get back to you."
    primary={{ label: 'Contact us', href: '/contact' }}
    secondary={{ label: 'Email us', href: `mailto:${contact.email}` }}
  />
</SiteLayout>
