---
import SiteLayout from '../layouts/SiteLayout.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ValuePills from '../components/ValuePills.astro';
import PhotoFrame from '../components/blocks/PhotoFrame.astro';
import { partners } from '../data/partners.json';
import { photos } from '../data/photos';
import site from '../data/site.json';

// Text: docs/content.md (About). The team section returns once leadership
// details are ready; the `team` collection is kept but not rendered.
const focus = [
  'Tarbiyat-led learning alongside academics',
  'Critical thinking over rote learning',
  'Teacher development through consistent training',
  'Co-curricular exposure through collaborations with universities and schools, including debates, storytelling, experiments, music and skill-based activities',
];
---

<SiteLayout title="About" description={site.description}>
  <PageHero eyebrow="About us" title="Our story" intro={site.description} breadcrumbs={[{ label: 'About' }]} />

  <section aria-label="Vision and mission" class="container-site grid gap-6 py-14 md:grid-cols-2 md:py-22">
    <div class="band-dark flex flex-col gap-3 rounded-card bg-purple p-8 text-white md:p-10">
      <h2 class="eyebrow text-cyan-light">Our vision</h2>
      <p class="text-[clamp(18px,2vw,21px)] leading-normal font-semibold">
        Our vision is an education system where academic learning goes hand in hand with tarbiyat: where children develop
        not just knowledge, but the character, values, manners and understanding to think clearly, act responsibly and
        contribute meaningfully to society.
      </p>
    </div>
    <div class="flex flex-col gap-3 rounded-card bg-cyan p-8 text-navy md:p-10">
      <h2 class="eyebrow">Our mission</h2>
      <p class="text-[clamp(18px,2vw,21px)] leading-normal font-semibold">
        {site.name} exists to make quality education accessible without compromising on its quality or affordability.
      </p>
      <p>
        We are building an alternative to rote-based learning through strong teaching practices, meaningful learning
        experiences and a commitment to developing the whole child.
      </p>
    </div>
  </section>

  <section aria-labelledby="then-now" class="bg-surface">
    <div class="container-site flex flex-col gap-10 py-14 md:py-22">
      <SectionHeading id="then-now" eyebrow="Our story" title="Then and now" />
      <div class="grid gap-8 md:grid-cols-2">
        <article class="flex flex-col gap-5 rounded-card bg-white p-6 md:p-8">
          <PhotoFrame label="[Photo: our first 5-marla building, 2019]" border="gold" tilt="-rotate-1" class="aspect-[4/3] w-full" />
          <p class="font-display text-stat text-purple">Then · {site.foundedYear}</p>
          <p class="text-lg text-ink-2">We started in a 5-marla building with 20 children.</p>
        </article>
        <article class="flex flex-col gap-5 rounded-card bg-white p-6 md:p-8">
          <PhotoFrame
            label="[Photo: the campus today]"
            photo={photos.studentsCelebratingCourtyard}
            border="cyan"
            tilt="rotate-1"
            sizes="(min-width: 1248px) 520px, (min-width: 768px) 45vw, calc(100vw - 80px)"
            class="aspect-[4/3] w-full"
          />
          <p class="font-display text-stat text-purple">Now</p>
          <p class="text-lg text-ink-2">
            We serve 300+ students on a 1.5-kanal purpose-built campus. We add a new grade each year, so our students can
            stay with us all the way to Matric.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section aria-labelledby="how-we-work" class="container-site grid gap-12 py-14 md:grid-cols-2 md:py-22">
    <div class="flex flex-col gap-4">
      <SectionHeading id="how-we-work" eyebrow="How we work" title="Quality education should not be a privilege" />
      <p class="text-ink-2">
        Al-Bayan is a not-for-profit school offering education from Playgroup to Matric. We operate through a combination of
        donations, Zakat and affordable student fees, to ensure both access and sustainability. We serve 300+ students with
        17–20 trained teachers and staff in an underserved community on Bedian Road, Lahore (Gohawa village).
      </p>
    </div>
    <div class="flex flex-col gap-4 rounded-card bg-surface p-8">
      <h2 class="text-[26px] leading-tight font-extrabold">Our focus</h2>
      <ul class="flex flex-col gap-3">
        {
          focus.map((item) => (
            <li class="flex gap-3 text-ink-2">
              <Icon name="check" size={22} class="mt-0.5 text-purple" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="values" class="bg-green">
    <div class="container-site flex flex-wrap items-center gap-10 py-14 md:py-20">
      <SectionHeading id="values" eyebrow="Core values" title="What we stand for" tone="on-colour" class="flex-[1_1_360px]" />
      <ValuePills onGreen hintTone="navy" class="flex-[1_1_440px]" />
    </div>
  </section>

  <section aria-labelledby="partners" class="band-dark bg-navy text-white">
    <div class="container-site flex flex-col gap-10 py-14 md:py-22">
      <SectionHeading id="partners" eyebrow="Partners" title="Partners and collaborations" tone="dark" />
      <dl class="grid gap-x-10 gap-y-6 md:grid-cols-2">
        {
          partners.map((partner) => (
            <div class="border-s-[3px] border-cyan ps-5">
              <dt class="text-lg font-bold">{partner.name}</dt>
              <dd class="text-on-navy">{partner.work}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CTABand />
</SiteLayout>
