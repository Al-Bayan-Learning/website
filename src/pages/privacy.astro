---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import site from '../data/site.json';
---

<SiteLayout title="Privacy" description={`How ${site.name} uses the information you share through this website.`}>
  <PageHero eyebrow="Privacy" title="Privacy policy" breadcrumbs={[{ label: 'Privacy' }]} />

  <article class="container-site py-12 md:py-16">
    <div class="prose-article mx-auto max-w-[720px]">
      <p><strong>Last updated: [Date]</strong></p>
      <p>[Privacy policy text: introduction, who we are and how to contact us about your data]</p>

      <h2>How we use your information</h2>
      <p>[Privacy policy text: what the website forms collect, why, who sees it and how long it is kept]</p>

      <h2>Photos of children</h2>
      <p>[Privacy policy text: photos of children appear only with written guardian consent, using first names or initials, and how to ask for a photo to be removed]</p>

      <h2>Cookies</h2>
      <p>[Privacy policy text: this website sets no cookies, to confirm]</p>

      <h2>Contact</h2>
      <p>Questions about your data? Email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.</p>
    </div>
  </article>
</SiteLayout>
