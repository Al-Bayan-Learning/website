---
import SiteLayout from '../layouts/SiteLayout.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import Placeholder from '../components/Placeholder.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StatTile from '../components/StatTile.astro';
import { volunteerCta } from '../data/navigation';
import { photos } from '../data/photos';
import site from '../data/site.json';
import { showDonate } from '../lib/launch';

// Text: docs/feedback-round-1.md (9c). Amounts, packages and bank details are
// placeholders until the team confirms them; never add account numbers here.
// Until the team approves this page (site.json → showDonate), production
// redirects it to the homepage; previews show it.
if (!showDonate()) return Astro.redirect('/');

const { contact } = site;
const packages = [1, 2, 3];
---

<SiteLayout title="Donate" description="Support Al-Bayan Learning Initiative with Zakat, Sadqa or a sponsorship, and help more children get a quality education.">
  <PageHero
    eyebrow="Donate"
    title="Support Al-Bayan"
    intro="Help us give more children a quality education, from Playgroup to Matric."
    breadcrumbs={[{ label: 'Donate' }]}
    photoLabel="[Photo: donate page hero, ideally happy children]"
    photo={photos.sportsGalaGroup}
  />

  <section aria-label="Our impact" class="container-site grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-5 pt-6 pb-14 md:pb-18">
    {site.stats.map((stat) => <StatTile value={stat.value} label={stat.label} colour={stat.colour as 'cyan' | 'gold' | 'green' | 'navy'} />)}
  </section>

  <section aria-labelledby="ways-to-give" class="container-site flex flex-col gap-9 pb-14 md:pb-22">
    <SectionHeading id="ways-to-give" eyebrow="Ways to give" title="Zakat and Sadqa are both accepted" />
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr_1.1fr]">
      <article class="flex flex-col gap-3 rounded-card bg-surface p-7">
        <span class="flex size-14 items-center justify-center rounded-icon bg-gold text-navy"><Icon name="heart" size={28} /></span>
        <h3 class="text-xl font-bold">Zakat</h3>
        <p class="text-ink-2">About 20% of our students receive Zakat-based financial assistance.</p>
      </article>
      <article class="flex flex-col gap-3 rounded-card bg-surface p-7">
        <span class="flex size-14 items-center justify-center rounded-icon bg-cyan text-navy"><Icon name="users" size={28} /></span>
        <h3 class="text-xl font-bold">Sadqa</h3>
        <p class="text-ink-2">Sadqa and general donations support the school, alongside Zakat and affordable student fees.</p>
      </article>
      <figure class="flex flex-col gap-3 rounded-card border-2 border-border p-5">
        <Placeholder label="[Show the Shariah/Zakat compliance certificate image]" class="aspect-[4/3] -rotate-1 rounded-card border-[5px] border-gold text-sm" />
        <figcaption class="text-sm font-semibold text-ink-2">Shariah/Zakat compliance certificate</figcaption>
      </figure>
    </div>
  </section>

  <section aria-labelledby="packages" class="bg-green">
    <div class="container-site flex flex-col gap-9 py-14 md:py-20">
      <SectionHeading id="packages" eyebrow="Sponsorship" title="Sponsorship packages" tone="on-colour" />
      <ul class="grid gap-6 md:grid-cols-3">
        {
          packages.map(() => (
            <li class="flex flex-col gap-3 rounded-card bg-white p-7">
              <h3 class="text-xl font-bold">[Package name]</h3>
              <p class="font-display text-[40px] leading-none text-purple">[Amount per month]</p>
              <p class="text-ink-2">[Short description]</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="appeal" class="band-dark bg-navy text-white">
    <div class="container-site flex flex-wrap items-center gap-12 py-14 md:py-22">
      <div class="flex flex-[1_1_440px] flex-col gap-5">
        <SectionHeading id="appeal" eyebrow="Current appeal" title="Our new floor for senior grades (Classes 8–10)" tone="dark" />
        <dl class="grid grid-cols-2 gap-4">
          <div class="rounded-card bg-white/5 p-5">
            <dt class="text-sm text-on-navy">Goal</dt>
            <dd class="text-xl font-bold">[Goal amount]</dd>
          </div>
          <div class="rounded-card bg-white/5 p-5">
            <dt class="text-sm text-on-navy">Raised so far</dt>
            <dd class="text-xl font-bold">[Progress]</dd>
          </div>
        </dl>
        <div aria-hidden="true" class="h-3 rounded-full border border-dashed border-on-navy-muted"></div>
      </div>
      <Placeholder label="[Photo: the new floor for senior grades]" class="aspect-[4/3] flex-[1_1_340px] rotate-2 rounded-card border-[5px] border-cyan" />
    </div>
  </section>

  <section aria-labelledby="how-to-donate" class="container-site flex flex-col gap-9 py-14 md:py-22">
    <SectionHeading id="how-to-donate" eyebrow="How to donate" title="How to give" />
    <div class="grid gap-6 md:grid-cols-2">
      <article class="flex flex-col gap-3 rounded-card bg-surface p-7">
        <h3 class="text-xl font-bold">Bank transfer</h3>
        <p class="text-ink-2">[Bank details, to be added after the account title is confirmed]</p>
      </article>
      <article class="flex flex-col gap-3 rounded-card bg-surface p-7">
        <h3 class="text-xl font-bold">Online giving</h3>
        <p class="text-ink-2">Online giving is coming soon.</p>
      </article>
    </div>
    <p class="text-ink-2">
      Questions about giving? Email <a href={`mailto:${contact.email}`} class="font-semibold">{contact.email}</a>
    </p>
  </section>

  <CTABand
    title="Prefer to give your time?"
    text="Volunteer with us, in person or remotely."
    primary={volunteerCta}
    secondary={{ label: 'Contact us', href: '/contact' }}
  />
</SiteLayout>
