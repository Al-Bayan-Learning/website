---
import SiteLayout from '../layouts/SiteLayout.astro';
import CTABand from '../components/CTABand.astro';
import PageHero from '../components/PageHero.astro';
import PhoneLinks from '../components/PhoneLinks.astro';
import SectionHeading from '../components/SectionHeading.astro';
import InfoCard from '../components/blocks/InfoCard.astro';
import PhotoFrame from '../components/blocks/PhotoFrame.astro';
import Field from '../components/forms/Field.astro';
import FormCard from '../components/forms/FormCard.astro';
import { photos } from '../data/photos';
import site from '../data/site.json';
import { phones } from '../lib/contact';

// A deliberately short page (docs/content.md → Admissions): the site speaks
// for Al-Bayan as an organisation, and parents aren't its main audience.
const { contact } = site;
---

<SiteLayout title="Admissions" description="Admission to Al-Bayan is open to all, from Playgroup to Matric. No admission fee for the first 10 students.">
  <PageHero
    eyebrow="Admissions"
    title="Join Al-Bayan"
    intro="Admission is open to all, from Playgroup to Matric. Fees are kept affordable, and every student receives a 50% tuition scholarship."
    breadcrumbs={[{ label: 'Admissions' }]}
  />

  <section aria-labelledby="who" class="container-site flex flex-wrap items-center gap-14 py-14 md:py-22">
    <div class="flex flex-[1_1_440px] flex-col gap-5">
      <SectionHeading id="who" eyebrow="Who can apply" title="Admission is open to all" />
      <p class="text-ink-2">
        Each child sits an admission test for their age group; for the youngest classes, such as Playgroup, this is a few
        oral questions.
      </p>
      <p class="text-ink-2">Fees are kept affordable, and every student receives a 50% tuition scholarship.</p>
      <p class="self-start rounded-card bg-gold px-6 py-4 text-lg font-bold text-navy">No admission fee for the first 10 students.</p>
    </div>
    <PhotoFrame
      label="[Photo: students at school]"
      photo={photos.scholarshipCertificates}
      border="cyan"
      tilt="rotate-2"
      sizes="(min-width: 1248px) 520px, (min-width: 768px) 42vw, calc(100vw - 48px)"
      class="aspect-[4/5] max-h-[520px] flex-[1_1_300px]"
    />
  </section>

  <section id="enquiry" aria-label="Admission enquiry" class="bg-surface">
    <div class="container-site grid items-start gap-10 py-14 lg:grid-cols-[1fr_1.4fr] md:py-22">
      <div class="flex flex-col gap-5">
        <SectionHeading eyebrow="Enquire" title="Talk to us about a place" />
        <p class="text-ink-2">Send the form, or reach us directly by email, phone or WhatsApp.</p>
        <InfoCard icon="mail" colour="cyan" title="Email">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </InfoCard>
        <InfoCard icon="phone" colour="gold" title="Phone and WhatsApp">
          <PhoneLinks />
        </InfoCard>
      </div>
      <FormCard id="admission-enquiry" title="Admission enquiry" submitLabel="Send enquiry">
        <Field form="admission-enquiry" name="guardian-name" label="Guardian's name" required autocomplete="name" />
        <Field form="admission-enquiry" name="phone" label="Phone number" type="tel" required autocomplete="tel" error="Please enter a phone number we can call." />
        <div class="grid gap-5 sm:grid-cols-2">
          <Field form="admission-enquiry" name="child-age" label="Child's age" type="number" required min="1" max="18" inputmode="numeric" error="Please enter your child's age in years." />
          <Field form="admission-enquiry" name="area" label="Area you live in" required autocomplete="address-level2" error="Please tell us which area you live in." />
        </div>
        <Field form="admission-enquiry" name="message" label="Message" type="textarea" hint="Anything you'd like us to know." />
      </FormCard>
    </div>
  </section>

  <CTABand
    title="Prefer to talk first?"
    text={`Call or WhatsApp ${phones[0].display}, or email ${contact.email}.`}
    primary={{ label: 'Contact us', href: '/contact' }}
    secondary={{ label: 'Call us', href: `tel:${phones[0].tel}` }}
  />
</SiteLayout>
