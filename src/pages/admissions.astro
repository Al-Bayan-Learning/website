---
import SiteLayout from '../layouts/SiteLayout.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FAQ from '../components/blocks/FAQ.astro';
import InfoCard from '../components/blocks/InfoCard.astro';
import Steps from '../components/blocks/Steps.astro';
import Field from '../components/forms/Field.astro';
import FormCard from '../components/forms/FormCard.astro';
import site from '../data/site.json';

const { contact } = site;
const telHref = `tel:${contact.phoneIntl.replace(/\s/g, '')}`;

const documents = [
  "[Document, e.g. child's birth certificate or B-form]",
  "[Document, e.g. guardian's CNIC copy]",
  '[Document, e.g. previous school report]',
  '[Document, e.g. passport-size photos]',
];

const steps = [
  { title: 'Send an enquiry', text: 'Fill in the form below, email us or call. We will get back to you.' },
  { title: '[Step, e.g. visit the campus]', text: '[What happens at this step]' },
  { title: '[Step, e.g. assessment]', text: '[What happens at this step]' },
  { title: '[Step, e.g. confirm the place]', text: '[What happens at this step, including fees]' },
];

const faqs = [
  { question: 'What ages do you admit?', answer: '[Answer: age ranges for each class, to confirm]' },
  { question: 'What are the fees?', answer: '[Answer: fee structure, to confirm]' },
  { question: 'Is financial support available?', answer: '[Answer: subsidies or scholarships, to confirm]' },
  { question: 'When does the school year start?', answer: '[Answer: session start month, to confirm]' },
];
---

<SiteLayout title="Admissions" description="Who can apply to Al-Bayan, the documents you need, how admission works, and how to send an admission enquiry.">
  <PageHero
    eyebrow="Admissions"
    title="Join Al-Bayan"
    intro="Find out who can apply, what you'll need and how the process works, then send us an enquiry."
    breadcrumbs={[{ label: 'Admissions' }]}
  />

  <section aria-label="Who can apply and documents" class="container-site grid items-start gap-10 py-14 md:grid-cols-2 md:py-22">
    <div class="flex flex-col gap-4">
      <SectionHeading id="who" eyebrow="Eligibility" title="Who can apply" />
      <p class="text-ink-2">
        We teach children from pre-school to middle school at a reasonable cost, funded partly by donors and partly by
        student fees.
      </p>
      <p class="text-ink-2">[Who can apply: age ranges, area served and any priority criteria, to confirm]</p>
    </div>
    <div class="flex flex-col gap-4 rounded-card bg-surface p-8">
      <h2 class="text-[26px] leading-tight font-extrabold">Documents needed</h2>
      <ul class="flex flex-col gap-3">
        {
          documents.map((doc) => (
            <li class="flex gap-3 text-ink-2">
              <Icon name="check" size={22} class="mt-0.5 text-purple" />
              {doc}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section aria-labelledby="steps" class="band-dark bg-navy text-white">
    <div class="container-site flex flex-col gap-10 py-14 md:py-22">
      <SectionHeading id="steps" eyebrow="How it works" title="Steps to admission" tone="dark" />
      <Steps steps={steps} />
    </div>
  </section>

  <section aria-labelledby="faqs" class="container-site grid gap-10 py-14 md:grid-cols-[1fr_1.6fr] md:py-22">
    <SectionHeading id="faqs" eyebrow="FAQs" title="Questions parents ask" class="self-start" />
    <FAQ items={faqs} />
  </section>

  <section id="enquiry" aria-label="Admission enquiry" class="bg-surface">
    <div class="container-site grid items-start gap-10 py-14 lg:grid-cols-[1fr_1.4fr] md:py-22">
      <div class="flex flex-col gap-5">
        <SectionHeading eyebrow="Enquire" title="Talk to us about a place" />
        <p class="text-ink-2">Send the form, or reach us directly. We usually reply within [response time].</p>
        <InfoCard icon="mail" colour="cyan" title="Email">
          <a href={`mailto:${contact.email}`}>{contact.email}</a>
        </InfoCard>
        <InfoCard icon="phone" colour="gold" title="Phone">
          <a href={telHref}>{contact.phone}</a>
        </InfoCard>
      </div>
      <FormCard id="admission-enquiry" title="Admission enquiry" submitLabel="Send enquiry">
        <Field form="admission-enquiry" name="guardian-name" label="Guardian's name" required autocomplete="name" />
        <Field form="admission-enquiry" name="phone" label="Phone number" type="tel" required autocomplete="tel" error="Please enter a phone number we can call." />
        <div class="grid gap-5 sm:grid-cols-2">
          <Field form="admission-enquiry" name="child-age" label="Child's age" type="number" required min="1" max="18" inputmode="numeric" error="Please enter your child's age in years." />
          <Field form="admission-enquiry" name="area" label="Area you live in" required autocomplete="address-level2" error="Please tell us which area you live in." />
        </div>
        <Field form="admission-enquiry" name="message" label="Message" type="textarea" hint="Anything you'd like us to know." />
      </FormCard>
    </div>
  </section>

  <CTABand
    title="Prefer to talk first?"
    text={`Call ${contact.phone} or email ${contact.email}.`}
    primary={{ label: 'Contact us', href: '/contact' }}
    secondary={{ label: 'Call us', href: telHref }}
  />
</SiteLayout>
