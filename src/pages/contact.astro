---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhoneLinks from '../components/PhoneLinks.astro';
import BrandIcon, { type BrandName } from '../components/BrandIcon.astro';
import InfoCard from '../components/blocks/InfoCard.astro';
import MapCard from '../components/blocks/MapCard.astro';
import { photos } from '../data/photos';
import site from '../data/site.json';
import { educationWhatsapp } from '../lib/contact';

const { contact, socials } = site;
---

<SiteLayout title="Contact" description={`Email, phone, WhatsApp, and address for ${site.name} in Lahore.`}>
  <PageHero
    eyebrow="Contact"
    title="Get in touch"
    intro="Want to donate, volunteer, or work with us? Email, call, or WhatsApp us."
    breadcrumbs={[{ label: 'Contact' }]}
    waveFill="fill-surface"
    photoLabel="[Photo: contact page hero, ideally happy children]"
    photo={photos.specialDayPomPoms}
  />

  <section aria-label="Contact details" class="bg-surface">
    <div class="container-site flex flex-col gap-6 pt-8 pb-14 md:pb-22">
      <div class="grid gap-6 md:grid-cols-2">
        <section aria-labelledby="general" class="flex flex-col gap-5 rounded-card bg-white p-6 sm:p-7">
          <div class="flex flex-col gap-1">
            <h2 id="general" class="text-xl font-extrabold text-navy">General enquiries</h2>
            <p class="text-sm text-muted">Donations, careers, and anything else.</p>
          </div>
          <InfoCard icon="mail" colour="cyan" title="Email" flat>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </InfoCard>
          <InfoCard icon="phone" colour="gold" title="Phone and WhatsApp" flat>
            <PhoneLinks />
          </InfoCard>
        </section>
        <section aria-labelledby="education-team" class="flex flex-col gap-5 rounded-card bg-white p-6 sm:p-7">
          <div class="flex flex-col gap-1">
            <h2 id="education-team" class="text-xl font-extrabold text-navy">Education team and collaborations</h2>
            <p class="text-sm text-muted">Volunteering, partnerships, and collaboration proposals.</p>
          </div>
          <InfoCard icon="mail" colour="cyan" title="Email" flat>
            <a href={`mailto:${contact.educationEmail}`}>{contact.educationEmail}</a>
          </InfoCard>
          <InfoCard icon="chat" colour="green" title="WhatsApp only" flat>
            <p class="text-sm text-muted">Messages only, no calls.</p>
            <PhoneLinks phones={educationWhatsapp} whatsappOnly />
          </InfoCard>
        </section>
      </div>

      <div class="grid items-start gap-6 lg:grid-cols-[1fr_1.4fr]">
        <div class="flex flex-col gap-6">
          <h2 class="sr-only">Campus and social media</h2>
          <InfoCard icon="pin" colour="green" title="Campus">
            {contact.address}
          </InfoCard>
          <InfoCard icon="share" colour="purple" title="Social media">
            <ul class="flex flex-wrap gap-x-5">
              {socials.map((social) => (
                <li>
                  <a href={social.url} class="inline-flex min-h-11 items-center gap-2 font-semibold">
                    <BrandIcon name={social.icon as BrandName} />
                    {social.name}
                  </a>
                </li>
              ))}
            </ul>
          </InfoCard>
        </div>
        <MapCard />
      </div>
    </div>
  </section>
</SiteLayout>
