---
import SiteLayout from '../layouts/SiteLayout.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import JobCard from '../components/cards/JobCard.astro';
import { photos } from '../data/photos';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

// Text: docs/feedback-round-1.md (9b); "Why work here" comes from the Academics text.
const { contact } = site;
const jobs = await getCollection('jobs', ({ data }) => data.open);

const reasons = [
  {
    title: 'Year-round training',
    text: 'Training, classroom feedback and office hours throughout the year, not just one annual workshop.',
  },
  {
    title: 'Subject meetings',
    text: 'Teachers of each subject meet regularly with our Education Team and experts in that field to plan how to teach it.',
  },
  {
    title: 'Expert-designed exams',
    text: 'A dedicated Education Team designs our exams to test understanding, not memorisation.',
  },
];
---

<SiteLayout title="Careers" description="Work with Al-Bayan: current openings, and how we train and support our teachers.">
  <PageHero
    eyebrow="Careers"
    title="Work with us"
    intro="Join a school that trains and supports its teachers all year."
    breadcrumbs={[{ label: 'Careers' }]}
    photoLabel="[Photo: careers page hero, a teacher in class]"
    photo={photos.parentTeacherMeeting}
    waveFill="fill-surface"
  />

  <section id="openings" aria-labelledby="openings-title" class="bg-surface">
    <div class="container-site flex flex-col gap-8 pt-8 pb-14 md:pb-22">
      <SectionHeading id="openings-title" eyebrow="Openings" title="Current openings" />
      {
        jobs.length > 0 ? (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-6">
            {jobs.map((job) => <JobCard entry={job} />)}
          </div>
        ) : (
          <p class="max-w-[640px] rounded-card border border-border bg-white p-8 text-lg text-ink-2">
            We don't have any openings right now. You're welcome to send your CV to{' '}
            <a href={`mailto:${contact.careersEmail}`} class="font-semibold">{contact.careersEmail}</a>.
          </p>
        )
      }
    </div>
  </section>

  <section aria-labelledby="why" class="container-site flex flex-col gap-9 py-14 md:py-22">
    <SectionHeading id="why" eyebrow="Why Al-Bayan" title="Why work at Al-Bayan" />
    <ul class="grid gap-6 md:grid-cols-3">
      {
        reasons.map((reason) => (
          <li class="flex flex-col gap-3 rounded-card bg-surface p-7">
            <Icon name="check" size={28} class="text-purple" />
            <h3 class="text-xl font-bold">{reason.title}</h3>
            <p class="text-ink-2">{reason.text}</p>
          </li>
        ))
      }
    </ul>
    <a href="/academics#teachers" class="inline-flex min-h-11 items-center self-start font-bold">How we support our teachers</a>
  </section>

  <CTABand />
</SiteLayout>
