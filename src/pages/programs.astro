---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import { getCollection } from 'astro:content';

// This is a full-site route. When the coming-soon gate is active the
// middleware rewrites it to the homepage, so this content never ships early.
const programs = (await getCollection('programs')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout title="Programs">
  <main class="mx-auto max-w-5xl space-y-10 px-6 py-16">
    <div class="space-y-2">
      <a href="/" class="text-sm font-medium text-teal-700 hover:text-teal-800">
        ← {site.name}
      </a>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900">Programs</h1>
    </div>

    <ul class="grid gap-6 sm:grid-cols-2">
      {
        programs.map((program) => (
          <li class="rounded-xl border border-slate-200 p-6">
            <p class="text-sm font-medium text-teal-700">{program.data.ageGroup}</p>
            <h2 class="mt-1 text-lg font-semibold text-slate-900">{program.data.title}</h2>
            <p class="mt-2 text-slate-600">{program.data.summary}</p>
          </li>
        ))
      }
    </ul>
  </main>
</Layout>
