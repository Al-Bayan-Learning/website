---
/**
 * Base HTML document: meta tags, favicon and global styles. The coming-soon
 * page uses this directly; full-site pages use SiteLayout, which adds the
 * skip link, header and footer.
 */
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  /** Replaces the whole <title> (it is not suffixed with the site name). */
  fullTitle?: string;
  description?: string;
  /** Hide from search engines (e.g. the 404 page). */
  noindex?: boolean;
}

const { title, fullTitle, description = site.description, noindex = false } = Astro.props;
// Page title always derives the school name from site.json — never hard-coded.
const pageTitle = fullTitle ?? (title ? `${title} · ${site.name}` : site.name);
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL('/images/albayan-logo.png', site.url).href;
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#6552A1" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-white text-navy antialiased">
    <slot />
  </body>
</html>
