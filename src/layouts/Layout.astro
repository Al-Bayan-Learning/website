---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  /** Replaces the whole <title> (it is not suffixed with the site name). */
  fullTitle?: string;
  description?: string;
}

const { title, fullTitle, description = site.tagline } = Astro.props;
// Page title always derives the school name from site.json — never hard-coded.
const pageTitle = fullTitle ?? (title ? `${title} · ${site.name}` : site.name);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-white text-slate-800 antialiased">
    <slot />
  </body>
</html>
