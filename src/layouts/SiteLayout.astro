---
/** Full-site page shell: skip link, announcement strip, header, main, footer. */
import Layout from './Layout.astro';
import AnnouncementStrip from '../components/AnnouncementStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NavigationProgress from '../components/NavigationProgress.astro';
// Preload the faces every full-site page shows above the fold, so text doesn't
// draw in a fallback font and then jump when Poppins arrives. Vite gives these
// the same hashed URLs the @font-face rules use, so nothing downloads twice.
import poppins400 from '@fontsource/poppins/files/poppins-latin-400-normal.woff2?url';
import poppins700 from '@fontsource/poppins/files/poppins-latin-700-normal.woff2?url';
import poppins800 from '@fontsource/poppins/files/poppins-latin-800-normal.woff2?url';
import bebas400 from '@fontsource/bebas-neue/files/bebas-neue-latin-400-normal.woff2?url';

const preloadFonts = [poppins400, poppins700, poppins800, bebas400];

type Props = {
  title?: string;
  fullTitle?: string;
  description?: string;
  noindex?: boolean;
};
---

<Layout {...Astro.props}>
  <Fragment slot="head">
    {preloadFonts.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
  </Fragment>
  <NavigationProgress />
  <a
    href="#main"
    class="sr-only z-50 rounded-full bg-navy px-6 py-3 font-bold text-white focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:text-white"
  >
    Skip to main content
  </a>
  <div class="overflow-x-clip">
    <!-- Named view-transition groups stay put while the page content fades. -->
    <div class="relative z-40 [view-transition-name:site-top]">
      <AnnouncementStrip />
      <Header />
    </div>
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
  </div>
</Layout>
