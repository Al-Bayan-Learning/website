---
/** Full-site page shell: skip link, announcement strip, header, main, footer. */
import Layout from './Layout.astro';
import AnnouncementStrip from '../components/AnnouncementStrip.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title?: string;
  fullTitle?: string;
  description?: string;
  noindex?: boolean;
};
---

<Layout {...Astro.props}>
  <a
    href="#main"
    class="sr-only z-50 rounded-full bg-navy px-6 py-3 font-bold text-white focus:not-sr-only focus:fixed focus:start-4 focus:top-4 focus:text-white"
  >
    Skip to main content
  </a>
  <div class="overflow-x-clip">
    <AnnouncementStrip />
    <Header />
    <main id="main" tabindex="-1" class="focus:outline-none">
      <slot />
    </main>
    <Footer />
  </div>
</Layout>
